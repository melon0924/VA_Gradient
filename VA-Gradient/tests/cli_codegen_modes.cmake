file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(output "${TEST_WORK_DIR}/model.c")
execute_process(COMMAND "${VAGRAD_EXE}" emit-c "${main}" --wrt G0 --wrt VTH0 --wrt TNOM -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${output}" text)
if(NOT status EQUAL 0 OR NOT text MATCHES "VAG_EXPORT int vagrad_eval_batch")
    message(FATAL_ERROR "C CLI failed: ${errors}")
endif()
file(WRITE "${output}" "previous C source")
execute_process(COMMAND "${VAGRAD_EXE}" emit-c "${main}" --wrt G0 --parameter-derivatives defaults -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${output}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CGEN_UNSUPPORTED" OR NOT after STREQUAL "previous C source")
    message(FATAL_ERROR "unsupported C mode must preserve previous source")
endif()
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
file(READ "${header}" before)
execute_process(COMMAND "${VAGRAD_EXE}" emit-c "${main}" --wrt G0 -o "${header}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${header}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
    message(FATAL_ERROR "C output must protect included source")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" emit-c "${main}" --wrt G0 -D TRACE_MOS=1 -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CGEN_UNSUPPORTED")
    message(FATAL_ERROR "unsupported diagnostic/string code must be rejected")
endif()
