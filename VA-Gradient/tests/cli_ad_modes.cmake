file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(output "${TEST_WORK_DIR}/model.ad.txt")
set(bias --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 300)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --wrt G0 --wrt VTH0 --wrt TNOM ${bias} -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "AD CLI failed: ${errors}")
endif()
file(READ "${output}" text)
foreach(expected IN ITEMS "Forward AD status=ok" "d(ids)/d(G0) = 0.02625" "d(flow:ds)/d(TNOM) = 8.75")
    string(FIND "${text}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "AD output missing ${expected}")
    endif()
endforeach()
execute_process(COMMAND "${VAGRAD_EXE}" ad-plan "${main}" --wrt G0 --wrt VTH0
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "AD seed support: slots=" OR NOT text MATCHES "G0" OR NOT text MATCHES "Derivative IR:")
    message(FATAL_ERROR "AD static plan must not require voltages/temperature: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --wrt G0 --ad-storage dense ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "Tangent storage=dense")
    message(FATAL_ERROR "dense reference mode must remain available: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" ad-plan "${main}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "ad-plan must require a derivative seed")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-slice --target ids@exit --effects target-only
    --wrt G0 --voltage d=.05 --voltage g=1 --voltage s=0
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "Forward AD status=ok")
    message(FATAL_ERROR "AD must work on the target slice: ${errors}")
endif()
file(WRITE "${output}" "previous gradient")
foreach(seed IN ITEMS ENABLE unknown G0)
    if(seed STREQUAL "G0")
        set(args --wrt G0 --wrt G0)
    else()
        set(args --wrt "${seed}")
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" ${args} ${bias} -o "${output}"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${output}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "AD_SEED" OR NOT after STREQUAL "previous gradient")
        message(FATAL_ERROR "invalid AD seeds must fail without replacing output")
    endif()
endforeach()
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
file(READ "${header}" before)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --wrt G0 ${bias} -o "${header}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${header}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
    message(FATAL_ERROR "AD must protect input header")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir hir --wrt G0
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "AD requires SSA execution")
endif()
set(chain "${TEST_DATA_DIR}/semantic/ad_parameter_chain.va")
foreach(mode IN ITEMS effective defaults)
    execute_process(COMMAND "${VAGRAD_EXE}" eval "${chain}" --wrt A --parameter-derivatives "${mode}"
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
    if(mode STREQUAL "defaults")
        set(expected "d(ids)/d(A) = 3")
    else()
        set(expected "d(ids)/d(A) = 0")
    endif()
    string(FIND "${text}" "${expected}" found)
    if(NOT status EQUAL 0 OR found EQUAL -1 OR NOT text MATCHES "parameters=${mode}")
        message(FATAL_ERROR "wrong default-chain CLI derivative: ${errors}\n${text}")
    endif()
endforeach()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${chain}" --wrt A --parameter-derivatives defaults --param B=5
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
string(FIND "${text}" "d(ids)/d(A) = 0" found)
if(NOT status EQUAL 0 OR found EQUAL -1)
    message(FATAL_ERROR "override must freeze non-seed default: ${errors}")
endif()
foreach(args IN ITEMS "--parameter-derivatives;defaults" "--wrt;A;--parameter-derivatives;unknown")
    execute_process(COMMAND "${VAGRAD_EXE}" eval "${chain}" ${args}
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "invalid parameter derivative option must fail")
    endif()
endforeach()
