file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(report "${TEST_WORK_DIR}/gradient-check.txt")
set(bias --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 300)
execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${main}" --wrt G0 --wrt VTH0 --wrt TNOM
    --step G0=1e-7 --step VTH0=1e-5 --step TNOM=.01 ${bias} -o "${report}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
file(READ "${report}" text)
if(NOT status EQUAL 0 OR NOT text MATCHES "Gradient check status=pass" OR NOT text MATCHES "PASS d")
    message(FATAL_ERROR "gradient CLI failed: ${errors}\n${text}")
endif()
set(chain "${TEST_DATA_DIR}/semantic/ad_parameter_chain.va")
foreach(mode IN ITEMS effective defaults)
    execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${chain}" --wrt A --parameter-derivatives "${mode}"
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
    if(NOT status EQUAL 0 OR NOT text MATCHES "Gradient check status=pass")
        message(FATAL_ERROR "gradient parameter mode failed: ${errors}\n${text}")
    endif()
endforeach()
set(bounded "${TEST_WORK_DIR}/bounded.va")
file(WRITE "${bounded}" "module m; parameter real P=0 from [0:inf); real ids; analog ids=P; endmodule")
file(WRITE "${report}" "previous complete report")
execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${bounded}" --wrt P -o "${report}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
file(READ "${report}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "GRADCHECK_RANGE" OR NOT after STREQUAL "previous complete report")
    message(FATAL_ERROR "incomplete range check must preserve previous report")
endif()
set(mismatch "${TEST_WORK_DIR}/mismatch.va")
file(WRITE "${mismatch}" "module m; parameter real P=.1; real ids; analog ids=abs(P); endmodule")
execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${mismatch}" --wrt P --step P=1 -o "${report}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
file(READ "${report}" text)
if(NOT status EQUAL 1 OR NOT text MATCHES "Gradient check status=fail" OR NOT text MATCHES "FAIL d")
    message(FATAL_ERROR "completed mismatch must export a FAIL report: ${errors}")
endif()
file(READ "${chain}" before)
execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${chain}" --wrt A -o "${chain}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
file(READ "${chain}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
    message(FATAL_ERROR "gradient report must protect input source")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" gradcheck "${main}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 2)
    message(FATAL_ERROR "gradcheck requires seeds")
endif()
