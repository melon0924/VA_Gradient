if(NOT DEFINED VAGRAD_EXE OR NOT DEFINED TEST_DATA_DIR OR NOT DEFINED TEST_WORK_DIR)
    message(FATAL_ERROR "VAGRAD_EXE, TEST_DATA_DIR and TEST_WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
set(report "${TEST_WORK_DIR}/model.typed.hir.txt")
set(numeric "${TEST_WORK_DIR}/model.eval.txt")

execute_process(COMMAND "${VAGRAD_EXE}" hir "${main}" --typed --param G0=2m -o "${report}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "H2 failed: ${errors}")
endif()
file(READ "${report}" output)
foreach(text IN ITEMS "ReadPotential(g, s)" "ContributeFlow" "Ref" "default=0.001 effective=0.002" "errors=0")
    string(FIND "${output}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "H2 report missing ${text}")
    endif()
endforeach()

execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}"
    --voltage d=0.05 --voltage g=1 --voltage s=0 --temperature 600 -o "${numeric}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "H3 failed: ${errors}")
endif()
file(READ "${numeric}" output)
if(NOT output MATCHES "HIR H3 status=ok" OR NOT output MATCHES "ids@exit = 2.625"
    OR NOT output MATCHES "flow\\(ds\\)@exit = 1.3125")
    message(FATAL_ERROR "H3 must report distinct ids and temperature-scaled flow: ${output}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" -DSOFT_THRESHOLD -DTRACE_MOS
    --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 300
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "diagnostic_record" OR NOT output MATCHES "status=ok")
    message(FATAL_ERROR "H3 configured source failed: ${errors}")
endif()

execute_process(COMMAND "${VAGRAD_EXE}" eval "${TEST_DATA_DIR}/semantic/parameter_dependencies.va"
    --voltage d=1 --voltage s=0 --param G0=2m RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "ids@exit = 0.004" OR NOT output MATCHES "EFFECTIVE_GAIN: Real default=0.002 effective=0.004")
    message(FATAL_ERROR "effective dependent defaults must use overridden G0: ${errors} ${output}")
endif()

execute_process(COMMAND "${VAGRAD_EXE}" hir "${TEST_DATA_DIR}/semantic/typed_errors.va" --typed -o "${report}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 1 OR NOT errors MATCHES "HIR_LVALUE" OR NOT errors MATCHES "HIR_TYPE")
    message(FATAL_ERROR "H2 must report typed errors: ${errors}")
endif()
file(READ "${report}" output)
if(NOT output MATCHES "Diagnostic HIR_LVALUE" OR NOT output MATCHES "Diagnostic HIR_TYPE")
    message(FATAL_ERROR "H2 must export reviewable partial HIR diagnostics")
endif()

# 所有失败的 eval 在打开输出前退出，保留上一次成功结果。
file(WRITE "${numeric}" "previous numerical result")
function(expect_failure expected)
    execute_process(COMMAND "${VAGRAD_EXE}" eval ${ARGN} -o "${numeric}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
    file(READ "${numeric}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "${expected}" OR NOT after STREQUAL "previous numerical result")
        message(FATAL_ERROR "expected ${expected}, got status ${status}: ${errors}")
    endif()
endfunction()
expect_failure(EVAL_INPUT "${main}" --voltage d=.05 --voltage s=0 --temperature 300)
expect_failure(EVAL_PARAMETER_RANGE "${main}" --param G0=0)
expect_failure(EVAL_DIV_ZERO "${TEST_DATA_DIR}/semantic/runtime_errors.va")
expect_failure(HIR_LVALUE "${TEST_DATA_DIR}/semantic/typed_errors.va")
expect_failure(HIR_DUPLICATE "${TEST_DATA_DIR}/semantic/binding_errors.va")
expect_failure(PARSE_EXPRESSION "${TEST_DATA_DIR}/parser_errors.va")
execute_process(COMMAND "${VAGRAD_EXE}" eval "${TEST_DATA_DIR}/semantic/runtime_errors.va" --param DENOM=2
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "ids@exit = 0.5")
    message(FATAL_ERROR "runtime override should repair denominator: ${errors}")
endif()

foreach(stage IN ITEMS typed eval)
    if(stage STREQUAL "typed")
        set(command hir "${main}" --typed)
    else()
        set(command eval "${main}" --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 300)
    endif()
    file(READ "${header}" before)
    execute_process(COMMAND "${VAGRAD_EXE}" ${command} -o "${header}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
    file(READ "${header}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
        message(FATAL_ERROR "${stage} must not overwrite an input header")
    endif()
endforeach()
foreach(case IN ITEMS missing malformed duplicate wrongstage no_typed)
    if(case STREQUAL "missing")
        set(args eval "${main}" --voltage)
    elseif(case STREQUAL "malformed")
        set(args eval "${main}" --param G0=1uMORE)
    elseif(case STREQUAL "duplicate")
        set(args eval "${main}" --voltage d=1 --voltage d=2)
    elseif(case STREQUAL "wrongstage")
        set(args eval "${main}" --dump-events)
    else()
        set(args hir "${main}" --param G0=2m)
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "bad CLI case ${case} must return 2")
    endif()
endforeach()
