file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
set(output "${TEST_WORK_DIR}/ids.slice.txt")
execute_process(COMMAND "${VAGRAD_EXE}" slice "${main}" --target ids@exit --effects target-only -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "slice export failed: ${errors}")
endif()
file(READ "${output}" text)
string(FIND "${text}" "target_inputs parameters=[ G0:Real VTH0:Real LEAK:Real ENABLE:Integer ]" found)
if(found EQUAL -1 OR NOT text MATCHES "temperature=0" OR NOT text MATCHES "verified=true")
    message(FATAL_ERROR "ids slice must report target inputs and verified CFG")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" slice "${main}" --target "flow(ds)@exit" --effects target-only
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "TNOM:Real" OR NOT text MATCHES "temperature=1")
    message(FATAL_ERROR "flow slice must retain temperature dependency: ${errors}")
endif()
set(bias --voltage d=.05 --voltage g=1 --voltage s=0)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-slice --target ids@exit --effects target-only ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "ids@exit = 2.625" OR NOT text MATCHES "SSA-Slice status=ok")
    message(FATAL_ERROR "isolated ids must execute without temperature: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-slice --target "flow(ds)@exit" --effects target-only ${bias} --temperature 600
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "flow\\(ds\\)@exit = 1.3125")
    message(FATAL_ERROR "flow slice numerical result: ${errors}")
endif()
file(WRITE "${output}" "previous result")
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-slice --target ids@exit ${bias} -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${output}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "EVAL_INPUT" OR NOT after STREQUAL "previous result")
    message(FATAL_ERROR "default preserve must retain temperature input checks and old output")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" slice "${main}" --target missing@exit -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${output}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "SLICE_TARGET" OR NOT after STREQUAL "previous result")
    message(FATAL_ERROR "invalid target must preserve old output")
endif()
foreach(mode IN ITEMS compile eval)
    file(READ "${header}" before)
    if(mode STREQUAL "compile")
        set(args slice "${main}" --target ids@exit)
    else()
        set(args eval "${main}" --ir mir-slice --target ids@exit --effects target-only ${bias})
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} -o "${header}" RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${header}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
        message(FATAL_ERROR "slice must protect input files")
    endif()
endforeach()
foreach(mode IN ITEMS missing wrong_policy wrong_ir)
    if(mode STREQUAL "missing")
        set(args slice "${main}")
    elseif(mode STREQUAL "wrong_policy")
        set(args slice "${main}" --target ids@exit --effects unknown)
    else()
        set(args eval "${main}" --ir mir-ssa --target ids@exit)
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "invalid slice options must return 2")
    endif()
endforeach()
