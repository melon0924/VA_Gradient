if(NOT DEFINED VAGRAD_EXE OR NOT DEFINED TEST_DATA_DIR OR NOT DEFINED TEST_WORK_DIR)
    message(FATAL_ERROR "VAGRAD_EXE, TEST_DATA_DIR and TEST_WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
set(mir "${TEST_WORK_DIR}/model.mir.txt")
set(cfg "${TEST_WORK_DIR}/model.cfg.txt")
set(numeric "${TEST_WORK_DIR}/model.mir.eval.txt")
execute_process(COMMAND "${VAGRAD_EXE}" mir "${main}" --form local -o "${mir}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "MIR export failed: ${errors}")
endif()
file(READ "${mir}" output)
foreach(text IN ITEMS "verified=true" "load_param" "load_local" "store_local" "branch" "contribute_flow" "return")
    string(FIND "${output}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "MIR report missing ${text}")
    endif()
endforeach()
execute_process(COMMAND "${VAGRAD_EXE}" cfg "${main}" -o "${cfg}" RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${cfg}" output)
if(NOT status EQUAL 0 OR NOT output MATCHES "predecessors" OR NOT output MATCHES "successors" OR NOT output MATCHES "reverse_postorder")
    message(FATAL_ERROR "CFG export failed: ${errors}")
endif()
set(bias --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 600)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-local ${bias} -o "${numeric}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${numeric}" output)
if(NOT status EQUAL 0 OR NOT output MATCHES "MIR-Local status=ok" OR NOT output MATCHES "flow\\(ds\\)@exit = 1.3125")
    message(FATAL_ERROR "MIR numerical export failed: ${errors} ${output}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir hir ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE hir ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT hir MATCHES "HIR H3 status=ok")
    message(FATAL_ERROR "--ir hir remains supported: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-local -DSOFT_THRESHOLD -DTRACE_MOS ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "diagnostic_record")
    message(FATAL_ERROR "MIR must preserve configured diagnostics: ${errors}")
endif()

file(WRITE "${numeric}" "previous result")
foreach(fixture IN ITEMS binding_errors typed_errors runtime_errors)
    execute_process(COMMAND "${VAGRAD_EXE}" eval "${TEST_DATA_DIR}/semantic/${fixture}.va" --ir mir-local -o "${numeric}"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${numeric}" after)
    if(NOT status EQUAL 1 OR NOT after STREQUAL "previous result")
        message(FATAL_ERROR "failed MIR evaluation must preserve output: ${fixture} ${errors}")
    endif()
endforeach()
foreach(stage IN ITEMS mir cfg)
    file(WRITE "${mir}" "previous IR")
    execute_process(COMMAND "${VAGRAD_EXE}" "${stage}" "${TEST_DATA_DIR}/parser_errors.va" -o "${mir}"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${mir}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "PARSE_EXPRESSION" OR NOT after STREQUAL "previous IR")
        message(FATAL_ERROR "syntax failure must stop ${stage} before opening output")
    endif()
    file(READ "${header}" before)
    execute_process(COMMAND "${VAGRAD_EXE}" "${stage}" "${main}" -o "${header}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
    file(READ "${header}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT after STREQUAL before)
        message(FATAL_ERROR "${stage} must protect input header")
    endif()
endforeach()
file(READ "${header}" before)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-local ${bias} -o "${header}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
file(READ "${header}" after)
if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
    message(FATAL_ERROR "MIR execution must protect input header")
endif()

# MIR 编译不要求参数默认环境可执行，也不把参数替换成默认常数。
set(cycle "${TEST_WORK_DIR}/cyclic_defaults.va")
file(WRITE "${cycle}" "module m; parameter real A=B; parameter real B=A; real ids; analog ids=A; endmodule")
execute_process(COMMAND "${VAGRAD_EXE}" mir "${cycle}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "load_param")
    message(FATAL_ERROR "MIR compilation must be independent of effective parameter resolution: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${cycle}" --ir mir-local --param A=2
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT output MATCHES "default_status=error effective_status=ok" OR NOT output MATCHES "ids@exit = 2")
    message(FATAL_ERROR "effective override must break cyclic default for MIR execution: ${errors}")
endif()
foreach(case IN ITEMS ssa bad_ir duplicate missing wrong_stage param_compile)
    if(case STREQUAL "ssa")
        set(args mir "${main}" --form unsupported)
    elseif(case STREQUAL "bad_ir")
        set(args eval "${main}" --ir unknown)
    elseif(case STREQUAL "duplicate")
        set(args eval "${main}" --ir hir --ir mir-local)
    elseif(case STREQUAL "missing")
        set(args eval "${main}" --ir)
    elseif(case STREQUAL "wrong_stage")
        set(args cfg "${main}" --form local)
    else()
        set(args mir "${main}" --param G0=1m)
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "unsupported options must return 2: ${case}")
    endif()
endforeach()
