if(NOT DEFINED VAGRAD_EXE OR NOT DEFINED TEST_DATA_DIR OR NOT DEFINED TEST_WORK_DIR)
    message(FATAL_ERROR "VAGRAD_EXE, TEST_DATA_DIR and TEST_WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
set(main "${TEST_DATA_DIR}/simple_mos.va")
set(header "${TEST_DATA_DIR}/include/simple_mos_defaults.vams")
set(output "${TEST_WORK_DIR}/model.ssa.txt")
execute_process(COMMAND "${VAGRAD_EXE}" mir "${main}" --form ssa -o "${output}"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "SSA construction failed: ${errors}")
endif()
file(READ "${output}" text)
foreach(expected IN ITEMS "MIR-SSA" "verified=true" "phi local" "ids@exit=v" "load_param")
    string(FIND "${text}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "SSA report missing ${expected}")
    endif()
endforeach()
foreach(removed IN ITEMS "load_local" "store_local")
    string(FIND "${text}" "${removed}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "promoted SSA must have no ${removed}")
    endif()
endforeach()
execute_process(COMMAND "${VAGRAD_EXE}" cfg "${main}" --dominators -o "${TEST_WORK_DIR}/dominance.txt"
    RESULT_VARIABLE status ERROR_VARIABLE errors)
file(READ "${TEST_WORK_DIR}/dominance.txt" text)
if(NOT status EQUAL 0 OR NOT text MATCHES "frontier=" OR NOT text MATCHES "idom=")
    message(FATAL_ERROR "dominance analysis failed: ${errors}")
endif()
set(bias --voltage d=.05 --voltage g=1 --voltage s=0 --temperature 600)
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-ssa ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "MIR-SSA status=ok" OR NOT text MATCHES "flow\\(ds\\)@exit = 1.3125")
    message(FATAL_ERROR "SSA evaluation failed: ${errors} ${text}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${main}" --ir mir-ssa -DSOFT_THRESHOLD -DTRACE_MOS ${bias}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "diagnostic_record")
    message(FATAL_ERROR "SSA must preserve configured diagnostics: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${TEST_DATA_DIR}/semantic/ssa_branch.va" --ir mir-ssa --param ENABLE=0
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "ids@exit = 0.003")
    message(FATAL_ERROR "phi must select the executed predecessor: ${errors}")
endif()
set(cycle "${TEST_WORK_DIR}/cycle.va")
file(WRITE "${cycle}" "module m; parameter real A=B; parameter real B=A; real ids; analog ids=A; endmodule")
execute_process(COMMAND "${VAGRAD_EXE}" mir "${cycle}" --form ssa
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "load_param")
    message(FATAL_ERROR "SSA compile must retain parameter loads: ${errors}")
endif()
execute_process(COMMAND "${VAGRAD_EXE}" eval "${cycle}" --ir mir-ssa --param A=2
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT text MATCHES "ids@exit = 2")
    message(FATAL_ERROR "SSA effective environment override: ${errors}")
endif()

file(WRITE "${output}" "previous result")
foreach(fixture IN ITEMS parser_errors semantic/binding_errors semantic/typed_errors semantic/runtime_errors)
    execute_process(COMMAND "${VAGRAD_EXE}" eval "${TEST_DATA_DIR}/${fixture}.va" --ir mir-ssa -o "${output}"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${output}" after)
    if(NOT status EQUAL 1 OR NOT after STREQUAL "previous result")
        message(FATAL_ERROR "failed SSA execution must preserve previous output: ${fixture} ${errors}")
    endif()
endforeach()
foreach(stage IN ITEMS compile eval dominance)
    if(stage STREQUAL "compile")
        set(args mir "${main}" --form ssa)
    elseif(stage STREQUAL "eval")
        set(args eval "${main}" --ir mir-ssa ${bias})
    else()
        set(args cfg "${main}" --dominators)
    endif()
    file(READ "${header}" before)
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} -o "${header}" RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE errors)
    file(READ "${header}" after)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "CLI_OUTPUT" OR NOT before STREQUAL after)
        message(FATAL_ERROR "SSA commands must protect input files: ${stage}")
    endif()
endforeach()
foreach(case IN ITEMS missing_form duplicate_form bad_form wrong_stage duplicate_dominance)
    if(case STREQUAL "missing_form")
        set(args mir "${main}" --form)
    elseif(case STREQUAL "duplicate_form")
        set(args mir "${main}" --form ssa --form local)
    elseif(case STREQUAL "bad_form")
        set(args mir "${main}" --form unknown)
    elseif(case STREQUAL "wrong_stage")
        set(args mir "${main}" --dominators)
    else()
        set(args cfg "${main}" --dominators --dominators)
    endif()
    execute_process(COMMAND "${VAGRAD_EXE}" ${args} RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(NOT status EQUAL 2)
        message(FATAL_ERROR "invalid SSA CLI must return 2: ${case}")
    endif()
endforeach()
